TZ=Asia/Kolkata

# Dokploy Compose env (Environment tab).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=realtypinnacle

# Backup admin (created/synced on every container start).
# Avoid @ : / # ? % in passwords if you also embed them in DATABASE_URL-style strings.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-strong-admin-password
ADMIN_NAME=Admin

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
