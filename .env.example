TZ=Asia/Kolkata

# Required — Dokploy Compose → Environment
POSTGRES_PASSWORD=change-me-to-a-strong-password
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-strong-admin-password

# Optional
POSTGRES_USER=postgres
POSTGRES_DB=realtypinnacle
ADMIN_NAME=Admin

# Session cookie signing (required in production — use a long random string)
SESSION_SECRET=change-me-to-a-long-random-session-secret

# Optional — public app URL used in password-reset links
# APP_URL=https://your-domain.com

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
