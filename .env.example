TZ=Asia/Kolkata

# Local / Dokploy Compose: hostname is the compose service name `db`.
# Dokploy managed Postgres (separate DB service in same project): paste the
# Internal Connection URL from the database service UI instead.
DATABASE_URL=postgresql://postgres:change-me@db:5432/realtypinnacle?schema=public

# Used by docker-compose.yml (Dokploy Compose env)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=realtypinnacle

# App runtime (usually set automatically in the image)
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
