TZ=Asia/Kolkata

# Dokploy Compose env (set these in the Compose service Environment tab).
# Use a strong password without @ : / # ? % — those break DATABASE_URL parsing.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=realtypinnacle

# Built automatically in docker-compose.yml as:
# postgresql://POSTGRES_USER:POSTGRES_PASSWORD@db:5432/POSTGRES_DB?schema=public
# Hostname `db` is the compose service name (same stack as the app).

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
